  "icon": "",
  "paramsSchema": {
    "type": "object",
    "properties": {
      "requester_id": {
        "type": "string",
        "description": "需求提报人的飞书用户ID"
      },
      "handler_id": {
        "description": "采购经办人的飞书用户ID",
        "type": "string"
      },
      "welcome_message": {
        "type": "string",
        "description": "入群欢迎消息，可包含采购需求相关提示信息"
      },
      "group_name": {
        "type": "string",
        "description": "飞书群组名称，建议格式：采购需求-{{需求编号}}沟通群"
      },
      "group_description": {
        "description": "群组描述，说明群组用途和相关采购需求信息",
        "type": "string"
      }
    },
    "required": [
      "group_name",
      "requester_id",
      "handler_id"
    ]
  },
  "formValue": {
    "owner": "1786247695118416",
    "members": [
